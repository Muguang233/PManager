{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PassManager",
  "version": "0.1.0",
  "identifier": "com.muguang.passmanager",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ui",
    "beforeBuildCommand": "npm run build --prefix ui",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "PassManager",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 520,
        "resizable": true,
        "decorations": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:5173 ws://localhost:5173; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [],
    "targets": "all"
  }
}
